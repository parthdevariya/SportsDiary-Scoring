{
  "name": "sports-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal multi-sport scoring, tournament and big-screen display platform",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "npm run build:web && node --no-warnings --import tsx apps/api/src/index.ts",
    "start": "npm run build:web && node --no-warnings --import tsx apps/api/src/index.ts",
    "seed": "node --no-warnings --import tsx scripts/seed.ts",
    "test": "node --no-warnings --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
